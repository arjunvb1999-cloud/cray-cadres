# Normalise line endings in the repository.
# Text files are stored with LF and checked out with LF on every platform,
# so line endings never cause noisy diffs between Windows and Linux.
* text=auto eol=lf

*.js   text eol=lf
*.jsx  text eol=lf
*.css  text eol=lf
*.html text eol=lf
*.json text eol=lf
*.md   text eol=lf
*.svg  text eol=lf
*.jpg  binary
*.jpeg binary
*.png  binary
*.webp binary
*.ico  binary
*.woff  binary
*.woff2 binary
